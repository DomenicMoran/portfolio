      "permanent": true
    },
    {
      "source": "/en/for-recruiters",
      "destination": "/en#hire",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/en#about",
      "permanent": true
    },
    {
      "source": "/en/work",
      "destination": "/en#work",
      "permanent": true
