{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|svg|webp|avif|ico|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cv",
      "destination": "/onepager",
      "permanent": true
    },
    {
      "source": "/lebenslauf",
      "destination": "/onepager",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/onepager",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/artikel",
      "permanent": true
    },
    {
      "source": "/en/blog",
      "destination": "/en/articles",
      "permanent": true
    },
    {
      "source": "/en/cv",
      "destination": "/en/onepager",
      "permanent": true
    },
    {
      "source": "/en/resume",
      "destination": "/en/onepager",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/artikel/feed.xml",
      "permanent": true
    },
    {
      "source": "/feed.xml",
      "destination": "/artikel/feed.xml",
      "permanent": true
    },
    {
      "source": "/rss",
      "destination": "/artikel/feed.xml",
      "permanent": true
    },
    {
      "source": "/rss.xml",
      "destination": "/artikel/feed.xml",
      "permanent": true
    },
    {
      "source": "/atom.xml",
      "destination": "/artikel/feed.xml",
      "permanent": true
    },
    {
      "source": "/en/feed",
      "destination": "/en/articles/feed.xml",
      "permanent": true
    },
    {
      "source": "/en/rss",
      "destination": "/en/articles/feed.xml",
      "permanent": true
    },
    {
      "source": "/recruiter",
      "destination": "/#hire",
      "permanent": true
    },
    {
      "source": "/en/recruiter",
      "destination": "/en#hire",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/en#contact",
      "permanent": true
    },
    {
      "source": "/en/contact",
      "destination": "/en#contact",
      "permanent": true
    },
    {
      "source": "/kurzprofil",
      "destination": "/onepager",
      "permanent": true
    },
    {
      "source": "/one-pager",
      "destination": "/onepager",
      "permanent": true
    },
    {
      "source": "/en/one-pager",
      "destination": "/en/onepager",
      "permanent": true
    },
    {
      "source": "/en/kurzprofil",
      "destination": "/en/onepager",
      "permanent": true
    },
    {
      "source": "/projekte",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/work",
