# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, the template always does
.env*
!.env.example

# vercel
.vercel

# playwright mcp scratch output
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Arbeitsdateien einer Sitzung, nie versionieren
_*.mjs
_*.png
_*.json

_about.txt
_deploy.log
_srv.log
_dep.log


# Arbeitsbäume und Sitzungsdaten von Agenten gehören nicht ins Repo.
.claude/

# Wegwerf-Skripte einer Prüfrunde. Sie greifen auf Nachbarrepos und auf die
# private Lernplattform zu und haben in einem öffentlichen Repo nichts verloren.
scripts/tmp-*
