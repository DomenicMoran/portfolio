# Kontaktformular. Ohne diese Werte zeigt das Formular einen ehrlichen
# Fehlerhinweis mit der direkten Mailadresse statt einer falschen Erfolgsmeldung.
# Einrichtung: siehe USER-TODO.md, Block B4.

# API-Key von https://resend.com (eigener Key für dieses Projekt, nicht
# wiederverwendet aus anderen Projekten).
RESEND_API_KEY=

# Wohin Anfragen zugestellt werden.
CONTACT_TO_EMAIL=

# Absender. Muss eine bei Resend verifizierte Domain sein.
# Beispiel: "Portfolio <hi@deine-domain.dev>"
CONTACT_FROM_EMAIL=
